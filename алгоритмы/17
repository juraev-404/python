from itertools import permutations

def brute_force_licenses(rates):
    n = len(rates)

    best_order = None
    min_cost = float('inf')

    # все возможные порядки
    for order in permutations(range(n)):

        total_cost = 0

        # считаем стоимость для данного порядка
        for month, license_index in enumerate(order):
            total_cost += 100 * (rates[license_index] ** month)

        # обновляем минимум
        if total_cost < min_cost:
            min_cost = total_cost
            best_order = order

    return best_order, min_cost


# пример
rates = [1.05, 1.2, 1.1, 1.4]

order, cost = brute_force_licenses(rates)




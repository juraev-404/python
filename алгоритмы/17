from itertools import permutations

def brute_force_selling(rates):
    n = len(rates)

    best_order = None
    max_profit = -1

    # перебираем все возможные порядки продажи
    for order in permutations(range(n)):

        total_profit = 0

        # считаем прибыль для данного порядка
        for month, item_index in enumerate(order):
            total_profit += 100 * (rates[item_index] ** month)

        # ищем максимальную прибыль
        if total_profit > max_profit:
            max_profit = total_profit
            best_order = order

    return best_order, max_profit


# пример
rates = [0.95, 0.7, 0.85, 0.99]

order, profit = brute_force_selling(rates)
